APP_NAME=Excursio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local MySQL (Laragon / XAMPP / MySQL installer)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=excursio
DB_USERNAME=root
DB_PASSWORD=
# Hosted MySQL that requires TLS (e.g. Aiven): path to the CA certificate
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/aiven-ca.pem

# Database-backed sessions and cache: required on hosts with ephemeral disks.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@excursio.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Excursio -------------------------------------------------------------
DEMO_PASSWORD=change-me-demo
EXCURSIO_DEMO_LOGINS=true
EXCURSIO_SERVICE_FEE_PERCENT=0
EXCURSIO_HOLD_MINUTES=10
EXCURSIO_APPROVAL_HOURS=24
EXCURSIO_PAYMENT_GATEWAY=demo
EXCURSIO_UPLOADS_ENABLED=false
EXCURSIO_DEMO_RESET=false
